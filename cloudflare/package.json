{
  "name": "cloudflare-container-networking-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:headless": "node --experimental-strip-types --test test/*.test.ts",
    "build:headless-v86": "esbuild src/headless-v86-entry.ts --bundle --platform=browser --format=esm --target=es2022 --define:require=undefined --define:process=undefined --external:crypto --external:fs --external:perf_hooks --external:node:* --outfile=dist/headless-v86-bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "v86": "0.5",
    "wrangler": "^4.0.0"
  }
}
